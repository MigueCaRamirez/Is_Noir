# =============================================================================
# IS NOIR - Plantilla segura
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.
#
# Solo las variables VITE_ son visibles en el navegador. La ANON KEY es publica
# por diseno, pero la SERVICE_ROLE_KEY, DATABASE_URL y los tokens de Supabase
# NUNCA deben incluirse aqui ni en ningun archivo dentro de src/.
# =============================================================================

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-publica
VITE_WHATSAPP_PHONE=573000000000
VITE_ADMIN_ALLOWED_EMAILS=admin1@example.com,admin2@example.com
VITE_CLOUDINARY_CLOUD_NAME=tu-cloud-name
VITE_CLOUDINARY_API_KEY=tu-api-key-publica

# Secreto exclusivo del servidor (Vercel Functions y npm run dev).
# Nunca lo prefijes con VITE_ ni lo importes desde src/.
CLOUDINARY_API_SECRET=tu-api-secret-privado
